// Defaults for collecting expedition footage. Nothing here assumes a cluster:
// `-profile local` is the whole thing on one machine, and the others exist so a
// long collection can move to a scheduler without the pipeline changing.

manifest {
    name        = 'pixel-patrol-deepsea'
    description = 'Collect expedition video into one parquet per expedition'
    mainScript  = 'main.nf'
    nextflowVersion = '>=23.04'
}

// Analysis is CPU-bound on the detector and holds one recording plus one model.
//
// One thread per task, and many tasks. Measured on a 16-core box, aggregate
// detector throughput:
//
//     1 process x 16 threads   1.13 frames/s
//     2 processes x 8 threads  1.83
//     4 processes x 4 threads  1.32
//     8 processes x 2 threads  1.70
//    16 processes x 1 thread   2.07     <- best
//
// Torch defaults to one thread per core, so a single pixel-patrol run already
// occupies the whole machine - and badly, because these convolutions do not scale
// intra-op. Pinning each task to one thread and running many is 1.8x faster. Not
// the 16x anyone hopes for: the model is memory-bandwidth bound, and that is the
// argument for a cluster rather than a bigger box.
process {
    cpus   = 1
    memory = '4 GB'
    // Without this, every task spawns a thread per core and they fight.
    beforeScript = 'export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1'
    withName: LIST  { cpus = 1; memory = '1 GB' }
    withName: MERGE { cpus = 1; memory = '8 GB' }
    // The page is built from every expedition report at once, and those carry the
    // cached stills: nine expeditions came to 6.1 GB on disk. It reads far less of
    // that than it used to, but it is still the step that holds the most at once,
    // and being killed for memory after every recording has been analysed is the
    // worst moment to find out.
    withName: SITE  { cpus = 1; memory = { 16.GB * task.attempt } }
}

profiles {
    // The default: every process shells out through `micromamba run -n pixel-patrol`,
    // so nothing needs activating before `nextflow run` and a scheduler node does
    // not need the environment on its PATH either.
    conda {
        // For letting Nextflow do the activating instead. A directory path is
        // activated as-is; a name would be solved from scratch.
        conda.enabled = true
        process.conda = System.getenv('PIXEL_PATROL_PREFIX')
            ?: "${System.getProperty('user.home')}/micromamba/envs/pixel-patrol"
        params.python = 'python'
    }
    local {
        executor.name = 'local'
        // As many as there are cores, minus a couple so the machine stays usable.
        // Each task holds one recording of scratch, so check the disk before
        // raising this: 8 tasks is about 600 MB in flight.
        executor.queueSize = 8
        executor.cpus = 14
    }
    slurm {
        process.executor = 'slurm'
        // The real win. Each task is one recording, independent, an hour of one
        // core; a hundred nodes is a hundred recordings at once.
        executor.queueSize = 100
        process.queue = 'batch'
        // Asked for explicitly, because the thing that kills a long collection on
        // a cluster is a queue whose default walltime is shorter than a recording.
        // The spread is wide: a five-minute 640x360 cruise recording is about 25
        // minutes on one core, and one fourteen-minute HD recording from the Axial
        // camera is a few hours, because cost follows the number of looks and the
        // size of the frame they are taken from, not the file.
        //
        // So the ask grows with the attempt. A task killed for running over comes
        // back with twice the time rather than being reported as a failed
        // recording, which is the honest reading of a timeout: nothing was wrong
        // with it except the estimate.
        //
        // The per-process times sit in a `process` block rather than being written
        // as bare `withName:` lines here: Nextflow 26 rejects a selector at the top
        // level of a profile, and only a run says so - `-profile slurm` is exactly
        // the path that is not exercised on the machine the config was edited on.
        process {
            time = { 2.h * task.attempt }
            maxRetries = 2
            withName: LIST    { time = '30m' }
            withName: ANALYSE { time = { 3.h * task.attempt } }
            withName: SELECT  { time = '1h' }  // a ranged read per dive, all HTTP
            withName: MERGE   { time = '1h' }
            withName: SITE    { time = '1h' }
        }
        // The detector is a 200 MB cache under $HOME/.cache/pixel-patrol (or
        // $XDG_CACHE_HOME). Fetch it once before submitting: on a cluster where
        // home is shared every node then has it, and on one where it is not,
        // point XDG_CACHE_HOME at somewhere that is.
    }
}

// A recording is staged into a temporary directory and deleted before its task
// ends, whatever happens to the work tree afterwards - `analyse_one` does that
// itself rather than leaving it to Nextflow - so a finished task directory holds
// a parquet and two logs, not a recording.
//
// Which is why this is false. `cleanup = true` deletes the work directory on a
// successful run, and a deleted work directory is exactly what `-resume` has
// nothing to resume from: the next run would redo every ANALYSE whose parquet is
// not published yet. Nothing is saved by it here.
cleanup = false
